# ─────────────────────────────────────────────────────────────────────────────
# SwarMind — configuration
#
#   cp .env.example .env
#
# then set ENCRYPTION_KEY (required) and replace every "change-me" value.
# ./start.sh does both for you on the first run.
# Comments stay on their own lines: Docker Compose reads this file as an env_file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED. Encrypts the LLM provider keys stored in the database (Fernet key: 32 url-safe
# base64 bytes). The backend does not start without it. Generate one with either command:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   openssl rand -base64 32 | tr '+/' '-_'
# Keep a copy in a safe place: if you lose or change it, the stored provider keys can no longer
# be decrypted and every user has to enter them again.
ENCRYPTION_KEY=

# Signs the login tokens (JWT). Empty: derived from ENCRYPTION_KEY, which is fine.
# Set your own random value (python3 -c "import secrets; print(secrets.token_hex(32))") if you
# want to sign everyone out without touching ENCRYPTION_KEY.
SECRET_KEY=

# PostgreSQL password, used by Compose for the database and for DATABASE_URL.
# Applied only when the postgres_data volume is created: see docs/manual (operations) to change it.
POSTGRES_PASSWORD=change-me-postgres-password

# Token shared by the Chroma server and the backend/worker.
CHROMA_TOKEN=change-me-chroma-token

# Redis password: Compose starts Redis with it and puts it in the REDIS_URL of backend, worker and
# Flower. Letters and digits only (it goes inside a URL): openssl rand -hex 32
# Installs from before this setting: add it, then docker compose up -d redis backend worker
# (see docs/manual, operations). The app refuses to start if Redis and REDIS_URL disagree.
REDIS_PASSWORD=change-me-redis-password

# ── Public URL ───────────────────────────────────────────────────────────────
# Address users open in the browser (no trailing slash). The only origin allowed by CORS and by
# the WebSocket. Behind a reverse proxy: https://swarmind.example.com
FRONTEND_URL=http://localhost:3000

# ── Landing page and billing ─────────────────────────────────────────────────
# Contact address shown by the landing page (contact section and footer) until an admin changes
# it in Admin > Site & branding. Empty: the contact section starts disabled. The landing itself
# is off until an admin turns it on.
CONTACT_EMAIL=

# Plans and monthly quotas always apply (an admin assigns plans to users). true: users also see
# the Pricing and Billing pages and the "Upgrade plan" links. There is no payment integration:
# with false (the default) the app never mentions payments.
BILLING_ENABLED=false

# ── LLM providers ────────────────────────────────────────────────────────────
# Nothing is required here. Each user adds provider keys (OpenRouter, Groq, OpenAI, Anthropic) and
# picks models from the UI: Settings > AI providers. Keys are stored encrypted with ENCRYPTION_KEY.
#
# Optional system key: a Groq key used for users who have not added a key of their own.
# Leave empty to require every user to bring their own key.
GROQ_API_KEY=
# Graph builds per user and per month on the system Groq key, for users without a provider key of
# their own (a user with one always builds with it). Counted in the same monthly period as the
# simulation quota. -1: no limit; 0: graph builds never use the system key.
GRAPH_SYSTEM_KEY_MONTHLY_LIMIT=20
# Models used with the system Groq key
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile
GROQ_MODEL_AGENT=openai/gpt-oss-20b
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── Simulation defaults ──────────────────────────────────────────────────────
# Agents and rounds proposed for a new simulation, and hard caps (plans can be lower)
DEFAULT_NUM_AGENTS=100
MAX_NUM_AGENTS=2000
DEFAULT_SIM_ROUNDS=30
MAX_SIM_ROUNDS=500
# Language of agents and report when the request sets none: en | it (invalid values mean en)
SIMULATION_DEFAULT_LANGUAGE=en
# >1.0 increases persona variety
AGENT_DIVERSITY_TEMPERATURE=1.3
# Opinion entropy below which the debate is considered converged
OPINION_ENTROPY_THRESHOLD=0.3
# Concurrent LLM calls per round
AGENT_CONCURRENCY=20
# At worker start-up, simulations still "running" after this many minutes with no live task are closed
STALE_SIMULATION_MINUTES=15

# ── Report agent ─────────────────────────────────────────────────────────────
REPORT_AGENT_MAX_TOOL_CALLS=10
REPORT_AGENT_MAX_REFLECTION_ROUNDS=3
REPORT_AGENT_TEMPERATURE=0.4

# ── Knowledge base embedding ─────────────────────────────────────────────────
# Empty: multilingual-e5-small (int8 ONNX, ~135 MB, downloaded once into the hf_cache volume).
# "default": Chroma's built-in all-MiniLM-L6-v2 (English-oriented, no download from Hugging Face).
KB_EMBEDDING=

# ── Brief parsing limits ─────────────────────────────────────────────────────
# Upper bounds on the text extracted from one brief, whatever the plan's file-size limit:
# compressed DOCX files and nested JSON can expand hundreds of times in the worker's memory.
MAX_EXTRACTED_CHARS=10000000
MAX_DOCX_UNCOMPRESSED_BYTES=104857600

# ── Chroma timeouts (seconds) ────────────────────────────────────────────────
CHROMA_CONNECT_TIMEOUT=5
CHROMA_READ_TIMEOUT=15
CHROMA_MEMORY_OP_TIMEOUT=10
CHROMA_KB_OP_TIMEOUT=10
CHROMA_KB_INGEST_TIMEOUT=600
# After a timeout or a network error, calls from the simulation loop skip Chroma for this long
CHROMA_COOLDOWN_SECONDS=30

# ── Monitoring (optional) ────────────────────────────────────────────────────
# Uncomment to also start Flower (Celery monitoring) on 127.0.0.1:5555
# COMPOSE_PROFILES=monitoring
FLOWER_USER=admin
FLOWER_PASSWORD=

# ── Flask ────────────────────────────────────────────────────────────────────
# Never true on a server reachable from the network
FLASK_DEBUG=False

# ── Set by docker-compose.yml ────────────────────────────────────────────────
# Only needed when running the backend outside Docker Compose (Compose overrides these):
# DATABASE_URL=postgresql://swarmind:<password>@localhost:5432/swarmind
# REDIS_URL=redis://:<redis password>@localhost:6379/0
# CELERY_BROKER_URL=redis://:<redis password>@localhost:6379/0
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
